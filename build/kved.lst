 630:kved.c        **** static bool kved_internal_data_delete(kved_data_t *data)
 631:kved.c        **** {
 632:kved.c        **** 	if(!started)
 633:kved.c        **** 		return false;
 634:kved.c        **** 
 635:kved.c        **** 	kved_word_t key = kved_key_encode(data);
 636:kved.c        **** 
 637:kved.c        **** 	if(!kved_is_valid_key(key))
 638:kved.c        **** 		return false;
 639:kved.c        **** 
 640:kved.c        **** 	uint16_t key_index = kved_key_index_find(key);
 641:kved.c        **** 
 642:kved.c        **** 	if(key_index == KVED_INDEX_NOT_FOUND)
 643:kved.c        **** 		return false;
 644:kved.c        **** 
 645:kved.c        **** 	kved_flash_data_write(ctrl.sector,key_index,KVED_DELETED_ENTRY);
 646:kved.c        **** 
 647:kved.c        **** 	ctrl.stats.num_deleted_entries++;
 648:kved.c        **** 	ctrl.stats.num_used_entries--;
 649:kved.c        **** 
 650:kved.c        **** #ifdef KVED_DEBUG
 651:kved.c        **** 	kved_dump();
 652:kved.c        **** #endif	
 653:kved.c        **** 
 654:kved.c        **** 	return true;
 655:kved.c        **** }
 656:kved.c        **** 
 657:kved.c        **** bool kved_data_delete(kved_data_t *data)
 658:kved.c        **** {
 659:kved.c        **** 	bool result;
 660:kved.c        **** 
 661:kved.c        **** 	kved_cpu_critical_section_enter();
 662:kved.c        **** 	result = kved_internal_data_delete(data);
 663:kved.c        **** 	kved_cpu_critical_section_leave();
 664:kved.c        **** 
 665:kved.c        **** 	return result;
 666:kved.c        **** }
