  89:kved.c        **** static void kved_print(kved_word_t val)
  90:kved.c        **** {
  91:kved.c        **** 	uint8_t *p = (uint8_t *) &val;
  92:kved.c        **** 
  93:kved.c        **** 	p += KVED_FLASH_WORD_SIZE - 1;
  94:kved.c        **** 	for(uint8_t n = 0 ; n < sizeof(kved_word_t) ; n++, p--)
  95:kved.c        **** 		printf("%02X",*p);
  96:kved.c        **** }
  97:kved.c        **** 
  98:kved.c        **** static void kved_print_ascii(kved_word_t val, size_t size, bool reverse)
  99:kved.c        **** {
 100:kved.c        **** 	uint8_t *p = (uint8_t *) &val;
 101:kved.c        **** 
 102:kved.c        **** 	if(reverse)
 103:kved.c        **** 		p += size - 1;
 104:kved.c        **** 
 105:kved.c        **** 	for(uint8_t n = 0 ; n < size ; n++)
 106:kved.c        **** 	{
 107:kved.c        **** 		if(isprint(*p))
 108:kved.c        **** 		{
 109:kved.c        **** 			printf("%c",*p);
 110:kved.c        **** 		}
 111:kved.c        **** 		else
 112:kved.c        **** 		{
 113:kved.c        **** 			printf(".");
 114:kved.c        **** 		}
 115:kved.c        **** 
 116:kved.c        **** 		if(reverse)
 117:kved.c        **** 			p--;
 118:kved.c        **** 		else
 119:kved.c        **** 			p++;
 120:kved.c        **** 	}
 121:kved.c        **** }
