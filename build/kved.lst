 368:kved.c        **** static bool kved_internal_data_write(kved_data_t *data)
 369:kved.c        **** {
 370:kved.c        **** 	bool sector_changed = false;
 371:kved.c        **** 
 372:kved.c        **** 	if(!started)
 373:kved.c        **** 		return false;
 374:kved.c        **** 
 375:kved.c        **** 	kved_word_t key = kved_key_encode(data);
 376:kved.c        **** 
 377:kved.c        **** 	if(!kved_is_valid_key(key))
 378:kved.c        **** 		return false;
 379:kved.c        **** 
 380:kved.c        **** 	uint16_t key_index = kved_key_index_find(key);
 381:kved.c        **** 	bool old_entry = key_index != KVED_INDEX_NOT_FOUND;
 382:kved.c        **** 
 383:kved.c        **** 	// check if the value has changed or not (for existing keys)
 384:kved.c        **** 	if(old_entry)
 385:kved.c        **** 	{
 386:kved.c        **** 		kved_word_t stored_value = kved_flash_data_read(ctrl.sector,key_index + 1);
 387:kved.c        **** 
 388:kved.c        **** 		if(stored_value == kved_value_encode(data))
 389:kved.c        **** 			return true;
 390:kved.c        **** 	}
 391:kved.c        **** 
 392:kved.c        **** 	// no space, exchanging sector do not solve this situation, you need more flash space !
 393:kved.c        **** 	if(ctrl.stats.num_total_entries == ctrl.stats.num_used_entries)
 394:kved.c        **** 		return false;
 395:kved.c        **** 
 396:kved.c        **** 	// ok, we have space but a clean up is required before. 
 397:kved.c        **** 	// Let's do a sector switch and leave the garbage behind.
 398:kved.c        **** 	// If we are writing using an existing entries it will
 399:kved.c        **** 	// be their valued updated during the process. 
 400:kved.c        **** 	if(ctrl.stats.num_free_entries == 0)
 401:kved.c        **** 	{
 402:kved.c        **** 		kved_word_t cnt = kved_flash_data_read(ctrl.sector,1);
 403:kved.c        **** 		kved_sector_switch(&ctrl,cnt,key,kved_value_encode(data));
 404:kved.c        **** 		sector_changed = true;
 405:kved.c        **** 	}
 406:kved.c        **** 
 407:kved.c        **** 	// AN existing entry is moved to the new sector using the new value already, not to do anymore.
 408:kved.c        **** 	// However we need to take care when a new entry is added or when we are updating an entry 
GAS LISTING /tmp/ccYqyADg.s 			page 10


 409:kved.c        **** 	// in the same sector. 
 410:kved.c        **** 	bool old_entry_updated_in_the_same_sector = (!sector_changed) && old_entry;
 411:kved.c        **** 
 412:kved.c        **** 	if(!old_entry || old_entry_updated_in_the_same_sector)
 413:kved.c        **** 	{
 414:kved.c        **** 		// first data, after key
 415:kved.c        **** 		kved_flash_data_write(ctrl.sector,ctrl.first_free_index + 1,kved_value_encode(data));
 416:kved.c        **** 		kved_flash_data_write(ctrl.sector,ctrl.first_free_index,key);
 417:kved.c        **** 
 418:kved.c        **** 		ctrl.stats.num_free_entries--;
 419:kved.c        **** 		ctrl.stats.num_used_entries++;
 420:kved.c        **** 		ctrl.first_free_index += KVED_ENTRY_SIZE_IN_WORDS;
 421:kved.c        **** 
 422:kved.c        **** 		// Existing data written in the same sector: erase the old entry
 423:kved.c        **** 		if(old_entry_updated_in_the_same_sector)
 424:kved.c        **** 		{
 425:kved.c        **** 			kved_flash_data_write(ctrl.sector,key_index,KVED_DELETED_ENTRY);
 426:kved.c        **** 
 427:kved.c        **** 			ctrl.stats.num_deleted_entries++;
 428:kved.c        **** 			ctrl.stats.num_used_entries--;
 429:kved.c        **** 		}
 430:kved.c        **** 	}
 431:kved.c        **** 
 432:kved.c        **** #ifdef KVED_DEBUG
 433:kved.c        **** 	kved_dump();
 434:kved.c        **** #endif	
 435:kved.c        **** 
 436:kved.c        **** 	return true;
 437:kved.c        **** }
