 668:kved.c        **** static void kved_internal_format(void)
 669:kved.c        **** {
 670:kved.c        **** 	// erase data and control
 671:kved.c        **** 	kved_flash_sector_erase(KVED_FLASH_SECTOR_A);
 672:kved.c        **** 	kved_flash_sector_erase(KVED_FLASH_SECTOR_B);
 673:kved.c        **** 	memset(&ctrl,0,sizeof(ctrl));
 674:kved.c        **** 
 675:kved.c        **** 	// setup sector as first sector and update stats.
 676:kved.c        **** 	// Consistency is not required in such situation.
 677:kved.c        **** 	ctrl.sector  = KVED_FLASH_SECTOR_A;
 678:kved.c        **** 	kved_flash_data_write(ctrl.sector,1,0);// first cnt, after ID
 679:kved.c        **** 	kved_flash_data_write(ctrl.sector,0,KVED_SIGNATURE_ENTRY);
 680:kved.c        **** 
 681:kved.c        **** 	kved_sector_stats_read(&ctrl);
 682:kved.c        **** }
