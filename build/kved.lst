 442:kved.c        **** 
 443:kved.c        **** 	kved_cpu_critical_section_enter();
 444:kved.c        **** 	result = kved_internal_data_write(data);
 445:kved.c        **** 	kved_cpu_critical_section_leave();
 446:kved.c        **** 
