 595:kved.c        **** static bool kved_internal_data_read(kved_data_t *data)
 596:kved.c        **** {
 597:kved.c        **** 	if(!started)
 598:kved.c        **** 		return false;
 599:kved.c        **** 
 600:kved.c        **** 	kved_word_t key = kved_key_encode(data);
 601:kved.c        **** 
 602:kved.c        **** 	if(!kved_is_valid_key(key))
 603:kved.c        **** 		return false;
 604:kved.c        **** 
 605:kved.c        **** 	uint16_t key_index = kved_key_index_find(key);
 606:kved.c        **** 
 607:kved.c        **** 	if(key_index == KVED_INDEX_NOT_FOUND)
 608:kved.c        **** 		return false;
 609:kved.c        **** 
 610:kved.c        **** 	 // update the type as user may not know about them before calling
 611:kved.c        **** 	data->type = KVED_HDR_MASK_TYPE(kved_flash_data_read(ctrl.sector,key_index));
 612:kved.c        **** 
 613:kved.c        **** 	 kved_word_t value = kved_flash_data_read(ctrl.sector,key_index+1);
 614:kved.c        **** 	 kved_value_decode(data,value);
 615:kved.c        **** 
 616:kved.c        **** 	return true;
 617:kved.c        **** }
